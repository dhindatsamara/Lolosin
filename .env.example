# Contoh env untuk Lolosin (file ini BOLEH di-commit, isinya placeholder).
# Salin ke file bernama .env lalu isi nilai aslinya.
# Nilai asli diisi user di Netlify (Site settings > Environment variables)
# saat deploy, bukan di repo ini.

# Project URL Supabase, misal https://rhoyeloqiorbspsucljt.supabase.co
VITE_SUPABASE_URL=https://contoh.supabase.co

# Publishable key Supabase (pengganti anon key lama, aman di browser).
# JANGAN pernah memakai Secret key di sini.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_contoh
